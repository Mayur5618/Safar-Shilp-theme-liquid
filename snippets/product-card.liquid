<div class="product-card" style="border: 1px solid #f0f0f0; border-radius: 8px; overflow: hidden; background: #fff; transition: transform 0.2s, box-shadow 0.2s;">
  <a href="{{ product.url }}" style="display: block; position: relative; overflow: hidden; text-decoration: none;">
    {%- if product.featured_image != blank -%}
      <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title }}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover;">
    {%- else -%}
      <img src="{{ 'p-1.png' | asset_url }}" alt="{{ product.title }}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover;">
    {%- endif -%}
  </a>
  <div style="padding: 16px;">
    <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 6px;">
      <a href="{{ product.url }}" style="color: #111111; text-decoration: none;">{{ product.title }}</a>
    </h3>
    <div style="font-size: 16px; font-weight: 700; color: #111;">{{ product.price | money }}</div>
  </div>
</div>
