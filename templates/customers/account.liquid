<div class="container" style="max-width: 1000px; margin: 50px auto; padding: 0 20px;">
  <h1 style="font-size: 28px; margin-bottom: 20px;">My Account</h1>
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;">
    <div>
      <h3 style="font-size: 18px; margin-bottom: 15px;">Order History</h3>
      {%- if customer.orders.size > 0 -%}
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 2px solid #eee; text-align: left;">
              <th style="padding: 10px;">Order</th>
              <th style="padding: 10px;">Date</th>
              <th style="padding: 10px;">Payment</th>
              <th style="padding: 10px;">Fulfillment</th>
              <th style="padding: 10px;">Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;"><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td style="padding: 10px;">{{ order.created_at | date: "%b %d, %Y" }}</td>
                <td style="padding: 10px;">{{ order.financial_status_label }}</td>
                <td style="padding: 10px;">{{ order.fulfillment_status_label }}</td>
                <td style="padding: 10px;">{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p style="color: #777;">You haven't placed any orders yet.</p>
      {%- endif -%}
    </div>
    <div style="background: #fafafa; padding: 25px; border-radius: 8px;">
      <h3 style="font-size: 18px; margin-bottom: 15px;">Account Details</h3>
      <p><b>{{ customer.name }}</b></p>
      <p>{{ customer.email }}</p>
      {%- if customer.default_address -%}
        <p>{{ customer.default_address.address1 }}<br>{{ customer.default_address.city }}, {{ customer.default_address.zip }}</p>
      {%- endif -%}
      <a href="/account/addresses" style="display: inline-block; margin-top: 15px; color: #111; text-decoration: underline;">View Addresses ({{ customer.addresses_count }})</a><br>
      <a href="/account/logout" style="display: inline-block; margin-top: 10px; color: #FF4747; text-decoration: none;">Sign Out</a>
    </div>
  </div>
</div>