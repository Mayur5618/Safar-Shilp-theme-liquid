<div class="container" style="max-width: 480px; margin: 60px auto; padding: 30px; background: #fff; border: 1px solid #eee; border-radius: 8px;">
  <h1 style="font-size: 24px; text-align: center; margin-bottom: 20px;">Activate Account</h1>
  {% form 'activate_customer_password' %}
    {{ form.errors | default_errors }}
    <button type="submit" style="width: 100%; height: 48px; background: #111; color: #fff; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">ACTIVATE ACCOUNT</button>
  {% endform %}
</div>