<div class="container" style="max-width: 480px; margin: 60px auto; padding: 30px; background: #fff; border: 1px solid #eee; border-radius: 8px;">
  <h1 style="font-size: 24px; text-align: center; margin-bottom: 20px;">Reset Password</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <div style="margin-bottom: 15px;">
      <label>New Password</label>
      <input type="password" name="customer[password]" style="width: 100%; height: 46px; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
    </div>
    <div style="margin-bottom: 20px;">
      <label>Confirm Password</label>
      <input type="password" name="customer[password_confirmation]" style="width: 100%; height: 46px; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
    </div>
    <button type="submit" style="width: 100%; height: 48px; background: #111; color: #fff; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">RESET PASSWORD</button>
  {% endform %}
</div>