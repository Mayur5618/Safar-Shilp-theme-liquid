<section class="hero-slider-section" style="position: relative; overflow: hidden;">
  <div class="hero-slide" style="position: relative; min-height: 600px; display: flex; align-items: center; background: #f4ede7; background-image: url({{ 'slider-1.jpg' | asset_url }}); background-size: cover; background-position: center;">
    <div class="container" style="padding: 60px 40px; max-width: 600px; margin-left: 8%;">
      <span style="display: block; text-transform: uppercase; font-size: 14px; letter-spacing: 2px; color: #FF4747; font-weight: 700; margin-bottom: 12px;">
        {{ section.settings.subheading | default: "New Season 2026" }}
      </span>
      <h1 style="font-size: 52px; line-height: 1.15; font-weight: 800; color: #111111; margin-bottom: 20px;">
        {{ section.settings.heading | default: "Summer Sensations & Coastal Vibes" }}
      </h1>
      <p style="font-size: 16px; color: #555555; margin-bottom: 30px; line-height: 1.6;">
        {{ section.settings.description | default: "Explore our handcrafted collection of premium swimwear, breezy resort pieces, and summer essentials." }}
      </p>
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn" style="display: inline-block; background: #111111; color: #ffffff; padding: 16px 36px; border-radius: 4px; font-weight: 600; text-transform: uppercase; text-decoration: none; transition: background 0.2s;">
        {{ section.settings.button_label | default: "Shop Collection" }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New Season 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Summer Sensations & Coastal Vibes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our handcrafted collection of premium swimwear, breezy resort pieces, and summer essentials."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Slider"
    }
  ]
}
{% endschema %}
